skinparam Shadowing false
skinparam dpi 300
skinparam DefaultFontName DejaVu Sans
skinparam DefaultFontSize 15
skinparam ArrowColor #1F3A5F
skinparam ArrowThickness 2
skinparam packageStyle rectangle
